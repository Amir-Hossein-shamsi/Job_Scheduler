# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=scheduler
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL='postgres://app:app@localhost:5432/scheduler?sslmode=disable'

# Redis
REDIS_ADDR=redis:6379

# Auth
JWT_EXPIRES_HOURS=24
ADMIN_USERNAME= admin
ADMIN_PASSWORD= change-this-development-password
JWT_SECRET= change-this-development-secret-to-at-least-32-characters
# Admin seed
ADMIN_EMAIL=admin@example.com
SQL_CREDENTIALS_KEY= change-this-development-secret-to-at-least-32-characters

# API
API_PORT=8080
